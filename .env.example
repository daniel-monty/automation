# MontyCloud E2E suite — environment template.
# Copy to `.env` and fill in. NEVER commit `.env`. Secrets stay out of the repo.

# --- Target environment (default: dev1) -------------------------------------
E2E_ENV=dev1
# Base API URL for the target env (dev1). Example shape only — fill the real one.
E2E_API_BASE_URL=https://dev-api.montycloud.com
# UI base URL for Playwright (the deployed React app for this env).
E2E_UI_BASE_URL=https://dev-app.montycloud.com

# --- Auth -------------------------------------------------------------------
# API key header value (x_api_key).
E2E_API_KEY=
# Cognito (token mint via USER_PASSWORD_AUTH). Use a dedicated NO-MFA test user.
E2E_COGNITO_REGION=us-east-1
E2E_COGNITO_USER_POOL_ID=
E2E_COGNITO_CLIENT_ID=
E2E_TEST_USERNAME=
E2E_TEST_PASSWORD=

# --- Contract / fuzz (schemathesis) -----------------------------------------
# Path or URL to the OpenAPI spec to fuzz (the richer spec you will provide).
E2E_OPENAPI_SPEC=

# --- AI failure triage (optional, OFF the gating path) ----------------------
E2E_LLM_PROVIDER=
E2E_LLM_API_KEY=
E2E_LLM_MODEL=

# --- Jira (requirement links + known-issues sync; optional) -----------------
E2E_JIRA_BASE_URL=
E2E_JIRA_PROJECT_KEY=
